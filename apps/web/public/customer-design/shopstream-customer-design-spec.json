    "textContrast": "4.5:1 minimum",
    "note": "The exact brand text-muted token is retained. Use text-muted-readable for dark-mode text. Semantic light-mode text uses stronger aliases, not the raw success/danger fills."
  },
  "behavior": "Frontend sample account. Changes remain only in the mounted account session. No real authentication, password changes, payments, delivery booking, cancellation or returns. Existing API-backed order pages remain available when the app is configured for live mode."
