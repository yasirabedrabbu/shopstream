  "accessibility": {
    "textContrast": "4.5:1 minimum",
    "note": "The exact brand text-muted token is retained. Use text-muted-readable for dark-mode text. Semantic light-mode text uses stronger aliases, not the raw success/danger fills."
  },
  "behavior": "Frontend-only demonstration. Administrative actions and settings last for this tab's mounted session. No authentication, email, payment, or server mutations are performed."
