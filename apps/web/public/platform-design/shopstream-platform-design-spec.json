          "ghost",
          "danger"
        ],
        "state": [
          "default",
          "hover",
          "focus",
          "disabled"
        ]
      },
      "minimumHeight": 48
    },
    "Switch": {
      "variants": {
        "checked": [
          true,
          false
        ]
      },
      "minimumHeight": 48
    },
    "Chart": {
      "variants": {
        "type": [
          "line",
          "bar",
          "donut"
        ],
        "compare": [
          true,
          false
        ]
      },
      "accessibility": [
        "text summary",
        "equivalent data table"
      ]
    }
