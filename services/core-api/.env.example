# services/core-api/.env.example
# Copy to services/core-api/.env and fill in real values.
# .env is git-ignored. Never commit it.
# Spring Boot does not read this file itself. Load it into PowerShell first (see services/core-api/README.md).

# ─── Database (Neon or local Postgres) ───────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/shopstream
DB_USER=shopstream
DB_PASSWORD=change_me_locally

# ─── JWT keys (PKCS#8, relative to services/core-api) ────────────────────────
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# ─── Seeded admin (created on first boot only) ───────────────────────────────
ADMIN_EMAIL=admin@shopstream.local
ADMIN_PASSWORD=change_me_locally

# ─── Feature flags ───────────────────────────────────────────────────────────
# Mock payments: dev only. Never true in production.
PAYMENT_MOCK_ENABLED=true
# Demo data seeder: never true on a real database.
SEED_ENABLED=false
SEED_VENDOR_PASSWORD=
# stub = stock not enforced. Switch when the Rust engine is connected.
INVENTORY_MODE=stub

# ─── SSLCOMMERZ (Bangladesh gateway) ─────────────────────────────────────────
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ─── Mail (local Mailpit on the docker-compose ports) ───────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=ShopStream <no-reply@shopstream.local>

# ─── URLs and CORS ───────────────────────────────────────────────────────────
# Frontend talks to the API through the Next.js proxy, so CORS is only a fallback.
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000